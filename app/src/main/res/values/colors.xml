    <!-- 框架颜色属性的纯色钉子：Material3 主题把这些 android.R.attr 指向了
         非纯色资源（选择器/引用链），splitties styledColor 解析会抛异常崩溃。
         在主题里显式钉成纯色后，所有 styledColor(android.R.attr.*) 调用都安全。 -->
    <color name="framework_control_normal">#76616C</color>
    <color name="framework_control_highlight">#1F944563</color>
    <color name="framework_text_primary">#30252C</color>
    <color name="framework_text_secondary">#75656F</color>
    <color name="framework_foreground">#30252C</color>
    <color name="framework_background">#FCECE8</color>
